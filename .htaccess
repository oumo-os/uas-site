RewriteEngine On

# Canonical host: www -> non-www (preserve path)
RewriteCond %{HTTP_HOST} ^www\.astronomy\.ug$ [NC]
RewriteRule ^(.*)$ https://astronomy.ug/$1 [R=301,L]

# Sitemap: /sitemap.xml -> sitemap.php
RewriteRule ^sitemap\.xml$ sitemap.php [L]

# Custom 404 page
ErrorDocument 404 /404.html

# /admin -> admin.html (must precede the directory check below)
RewriteRule ^admin/?$ admin.html [L]

# Detail pages via slug.php: serves the template with item-specific Open Graph
# tags injected server-side (scrapers like WhatsApp don't run JavaScript).
# Clean URLs stay unchanged (200, no redirect).
RewriteRule ^events/([a-z0-9-]+)/?$ slug.php?type=event&slug=$1 [QSA,L]
RewriteRule ^event/([a-z0-9-]+)/?$ slug.php?type=event&slug=$1 [QSA,L]
RewriteRule ^programmes?/(\d+)/?$ slug.php?type=programme&id=$1 [QSA,L]
RewriteRule ^articles?/(\d+)/?$ slug.php?type=article&id=$1 [QSA,L]

# Clean URLs: /about -> about.html, etc. (only when matching file exists)
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^([a-z0-9-]+)$ $1.html [QSA,L]

# Root slugs: programmes & projects at astronomy.ug/<slug>
# Only for non-file single segments that aren't static pages; keeps /<slug> URL with 200
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/$1.html !-f
RewriteRule ^([a-z0-9-]+)/?$ slug.php?slug=$1 [QSA,L]

# Absorb preload-scanner requests that raced the dynamic <base> on deep routes
# (e.g. /article/css/base.css -> /css/base.css). The scanner resolves relative
# asset refs against the page URL before the base-setting script runs; these
# stale requests are harmless but noisy, so map them to the app root instead.
RewriteRule ^[^/]+/css/(.*)$ css/$1 [L]
RewriteRule ^[^/]+/js/(.*)$ js/$1 [L]
RewriteRule ^[^/]+/img/(.*)$ img/$1 [L]

# API: /api/... -> api/index.php
RewriteRule ^api/(.*)$ api/index.php?route=$1 [QSA,L]

# Cache policy: HTML always revalidates so deploys take effect immediately.
# CSS/JS carry ?v= version params, so they can be cached long-term safely.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
</IfModule>
