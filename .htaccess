RewriteEngine On

# Custom 404 page
ErrorDocument 404 /404.html

# /admin -> admin.html (must precede the directory check below)
RewriteRule ^admin/?$ admin.html [L]

# Clean URLs: /about -> about.html, etc.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([a-z0-9-]+)$ $1.html [QSA,L]

# Programme detail: /programmes/3 or /programme/3 -> programme.html?id=3
RewriteRule ^programmes?/(\d+)/?$ programme.html?id=$1 [QSA,L]

# Article detail: /article/5 -> article.html?id=5
RewriteRule ^article/(\d+)/?$ article.html?id=$1 [QSA,L]

# Event detail: /event/3 -> event.html?id=3
RewriteRule ^event/(\d+)/?$ event.html?id=$1 [QSA,L]

# Absorb preload-scanner requests that raced the dynamic <base> on deep routes
# (e.g. /article/css/base.css -> /css/base.css). The scanner resolves relative
# asset refs against the page URL before the base-setting script runs; these
# stale requests are harmless but noisy, so map them to the app root instead.
RewriteRule ^[^/]+/css/(.*)$ css/$1 [L]
RewriteRule ^[^/]+/js/(.*)$ js/$1 [L]
RewriteRule ^[^/]+/img/(.*)$ img/$1 [L]

# API: /api/... -> api/index.php
RewriteRule ^api/(.*)$ api/index.php?route=$1 [QSA,L]
